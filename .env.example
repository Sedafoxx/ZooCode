# ZooCode local secrets — copy to `.env` (gitignored) and fill in.
#
# Only needed for LIVE runs against the real DeepSeek API.
# Everything else works without it: `--mock` never reads the key.
#
#   Copy-Item .env.example .env      # PowerShell
#   cp .env.example .env             # bash/zsh
#
# A real environment variable always wins over this file — see lib/dotenv.ts.

# Required for live agent runs.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides (defaults shown).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# ZOO_MAX_STEPS=25
# ZOO_CONCURRENCY=3
# ZOO_TEMPERATURE=0.2
# Context budget (estimated tokens per request) and how many recent message
# groups stay verbatim. Both are estimates; see README "Context management".
# ZOO_CONTEXT_BUDGET_TOKENS=128000
# ZOO_CONTEXT_KEEP_GROUPS=6
