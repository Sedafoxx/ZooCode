{
  "name": "zoocode",
  "private": true,
  "version": "0.0.1",
  "description": "Homegrown agent harness — a layered LLM agent loop, tools, sub-agents, and CLI",
  "type": "module",
  "bin": {
    "zoocode": "bin/zoocode.ts"
  },
  "scripts": {
    "zoocode": "tsx bin/zoocode.ts",
    "agent": "tsx bin/zoocode.ts agent",
    "doctor": "tsx bin/zoocode.ts doctor",
    "scaffold": "tsx scripts/scaffold.ts",
    "analyze": "tsx scripts/analyze.ts",
    "search": "tsx scripts/search.ts",
    "live": "tsx scripts/live-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "verify": "oxlint && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vitest": "^3.1.0"
  }
}
